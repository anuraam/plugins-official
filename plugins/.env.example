# GitHub Personal Access Token
# Provide your GitHub personal access token here.
# This token is used to authenticate API requests to GitHub, such as accessing repositories and performing operations on them.
GITHUB-TOKEN=github_pat_your_token_here

# Azure DevOps Personal Access Token
# Enter your Azure DevOps personal access token here.
# This token is required to authenticate API requests to Azure DevOps services, allowing access to projects and repositories as specified by its permissions.
AZURE-DEVOPS-TOKEN=your_azure_devops_pat_here

# GitHub Repository URL for Testing
# Specify the HTTPS URL of the GitHub repository you want to use for automated tests or plugin operations.
# Example format: https://github.com/your-org/your-repo
GITHUB_TEST_REPO=https://github.com/your-org/your-repo

# Azure DevOps Repository URL for Testing
# Specify the HTTPS URL of the Azure DevOps repository you want to use for automated tests or plugin operations.
# Example format: https://dev.azure.com/your-org/your-project/_git/your-repo
AZURE_DEVOPS_TEST_REPO=https://dev.azure.com/your-org/your-project/_git/your-repo
